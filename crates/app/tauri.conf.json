{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinkGroupz",
  "identifier": "dev.linkgroupz.LinkGroupz",
  "mainBinaryName": "linkgroupz",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": "",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "category": "Productivity",
    "shortDescription": "자주 여는 웹 페이지를 그룹으로 묶어 Chrome · Edge 에 한 번에 엽니다",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/linkgroupz-host"],
    "resources": {
      "../../chrome-extension/": "chrome-extension/",
      "../../docs/guide/": "guide/",
      "../../THIRD-PARTY-LICENSES.html": "THIRD-PARTY-LICENSES.html"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
