# 자동 업데이트 설정. 소스에 두지 않는 값이라, 이 파일을 update-source.env 로 복사해 채운다
# (update-source.env 는 git 에 올리지 않는다). 없으면 자동 업데이트 없이 빌드된다.
# 같은 이름의 환경 변수로 줘도 된다.

# 배포 파일(릴리스)을 올리는 GitHub 저장소: 소유자/이름. 앱이 로그인 없이 받으므로 공개 저장소여야 한다.
LINKGROUPZ_RELEASES_REPO=someone/linkgroupz

# 받은 파일의 서명을 확인할 공개 키: `npx @tauri-apps/cli signer generate -w ~/.tauri/linkgroupz-updater.key` 가 만든 .pub 파일의 내용.
# (비밀 키 ~/.tauri/linkgroupz-updater.key 는 릴리스를 만드는 컴퓨터에만 둔다.)
LINKGROUPZ_UPDATE_PUBKEY=
